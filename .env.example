# ===========================================
# Cold-Calling AI Voice Agent — Environment
# Copy this file to .env and fill in your keys
# ===========================================

# VAPI (Required — free $10 credits, no card) — https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_ASSISTANT_ID=your_assistant_id_after_creation
VAPI_PHONE_NUMBER_ID=your_phone_number_id_from_vapi_dashboard

# Groq (Required — 100% free AI) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# App / Deployment (Vercel — free Hobby tier is enough forever for this demo)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key_here
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_assistant_id_after_creation
APP_URL=https://your-deployed-app.vercel.app
NODE_ENV=development

# Optional: protect POST /api/archive/sync. GitHub Action also needs repo secret VAPI_API_KEY.
# ARCHIVE_SYNC_SECRET=any_long_random_string

# Call History: unset = GitHub archive ONLY (recommended). Set HISTORY_INCLUDE_VAPI=1 to also merge live VAPI.
# HISTORY_INCLUDE_VAPI=1

# Optional: limit VAPI list pages during archive (1–10). Default 10 (local quick uses 2).
# ARCHIVE_MAX_PAGES=3

# --- Auto archive push + durable deletes on Vercel ---
# 1) Create a GitHub PAT (repo scope) → add as Vercel env GITHUB_TOKEN (and optionally root .env)
# 2) GITHUB_REPO=owner/Cold-Calling-Agent
# 3) GitHub repo Secrets: VAPI_API_KEY (for the archive Action)
# Webhook end-of-call → repository_dispatch → Action archives → git push → Vercel redeploy
# Delete button → updates deleted.json on GitHub so recording disappears after redeploy
# GITHUB_TOKEN=
# GITHUB_REPO=rohaan2802/Cold-Calling-Agent
# ARCHIVE_GITHUB_TOKEN=

